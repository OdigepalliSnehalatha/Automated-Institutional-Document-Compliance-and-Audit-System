# ==============================================================================
# Automated Institutional Document Compliance and Audit System
# Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your actual '.env' file or production credentials to source control.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mydatabase

# Application Session Security Secret
SESSION_SECRET=replace-with-a-random-secure-secret-key-32-chars-minimum

# ==============================================================================
# Real Email OTP Service (Gmail SMTP / Institutional SMTP)
# ==============================================================================
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create a new App Password named e.g. "Compliance Audit System"
# 4. Paste the 16-character generated password below as SMTP_PASSWORD (without spaces)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-institutional-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-institutional-email@gmail.com
