# ==============================================================================
# Automated Institutional Document Compliance and Audit System
# Environment Configuration Template (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydatabase

# Application Session Security Secret
SESSION_SECRET=replace-with-a-random-secure-secret-key-32-chars-minimum

# ==============================================================================
# n8n Automation & Realistic OTP Workflow Settings
# ==============================================================================
# Set to 'true' to automatically trigger the n8n email automation webhook
N8N_ENABLED=true

# Webhook URL for the n8n workflow (default local port is 5678)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/send-otp

# Timeout for n8n webhook requests in seconds
N8N_TIMEOUT=5.0

# Realistic OTP Delivery:
# When set to 'false', the OTP is sent ONLY to the user's email via n8n.
# When set to 'true', the OTP is also returned in the API response for dev testing.
DEV_EXPOSE_OTP=false

# Optional API authentication key for the n8n webhook
N8N_API_KEY=

# ==============================================================================
# Real Email OTP Service (Gmail SMTP / Institutional SMTP)
# ==============================================================================
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create a new App Password named e.g. "Compliance Audit System"
# 4. Paste the 16-character generated password below as SMTP_PASSWORD (without spaces)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-institutional-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-institutional-email@gmail.com
